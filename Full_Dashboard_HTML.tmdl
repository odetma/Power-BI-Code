createOrReplace

	ref table FactSales

		/// דשבורד HTML אינטראקטיבי מבוסס details/summary בלבד: סקירה פתוחה כברירת מחדל, ניווט לעמודי מוצרים, לקוחות וזמן ללא anchors או JavaScript.
		measure 'Full Page Sales Dashboard' =
				VAR Shekel = UNICHAR(8362)
				VAR TotalSales = [Total Sales]
				VAR TotalQty = [Total Quantity]
				VAR Orders = COUNTROWS(FactSales)
				VAR Customers = DISTINCTCOUNT(DimCustomer[CustomerKey])
				VAR AvgOrder = DIVIDE(TotalSales, Orders)
				VAR Cat = ADDCOLUMNS(VALUES(DimProduct[CategoryName]), "__sales", [Total Sales], "__qty", [Total Quantity])
				VAR Prod = ADDCOLUMNS(VALUES(DimProduct[ProductName]), "__sales", [Total Sales], "__qty", [Total Quantity])
				VAR City = ADDCOLUMNS(VALUES(DimCustomer[CityName]), "__sales", [Total Sales])
				VAR Seg = ADDCOLUMNS(VALUES(DimCustomer[CustomerSegment]), "__sales", [Total Sales], "__cust", CALCULATE(DISTINCTCOUNT(DimCustomer[CustomerKey])))
				VAR YearT = ADDCOLUMNS(VALUES(DimDate[YearNumber]), "__sales", [Total Sales])
				VAR MaxCat = MAXX(Cat, [__sales])
				VAR MaxProd = MAXX(Prod, [__sales])
				VAR MaxCity = MAXX(City, [__sales])
				VAR MaxSeg = MAXX(Seg, [__sales])
				VAR MaxYear = MAXX(YearT, [__sales])
				VAR YearCount = COUNTROWS(YearT)
				VAR TopCat = MAXX(TOPN(1, Cat, [__sales], DESC), DimProduct[CategoryName])
				VAR TopProd = MAXX(TOPN(1, Prod, [__sales], DESC), DimProduct[ProductName])
				VAR TopCity = MAXX(TOPN(1, City, [__sales], DESC), DimCustomer[CityName])
				VAR TopSeg = MAXX(TOPN(1, Seg, [__sales], DESC), DimCustomer[CustomerSegment])
				VAR CatRows = CONCATENATEX(TOPN(6, Cat, [__sales], DESC), VAR N=COALESCE(DimProduct[CategoryName],"לא ידוע") VAR W=FORMAT(DIVIDE([__sales],MaxCat,0)*100,"0")&"%" RETURN "<div class='r'><span>"&N&"</span><div class='bar'><i style='width:"&W&"'></i></div><b>"&Shekel&FORMAT([__sales],"#,##0")&"</b></div>","")
				VAR ProdRows = CONCATENATEX(TOPN(8, Prod, [__sales], DESC), VAR N=COALESCE(DimProduct[ProductName],"לא ידוע") VAR W=FORMAT(DIVIDE([__sales],MaxProd,0)*100,"0")&"%" RETURN "<details class='mini'><summary><span>"&N&"</span><b>"&Shekel&FORMAT([__sales],"#,##0")&"</b></summary><div class='bar orange'><i style='width:"&W&"'></i></div><p>כמות שנמכרה: <b>"&FORMAT([__qty],"#,##0")&"</b></p></details>","")
				VAR CityRows = CONCATENATEX(TOPN(6, City, [__sales], DESC), VAR N=COALESCE(DimCustomer[CityName],"לא ידוע") VAR W=FORMAT(DIVIDE([__sales],MaxCity,0)*100,"0")&"%" RETURN "<div class='r'><span>"&N&"</span><div class='bar teal'><i style='width:"&W&"'></i></div><b>"&Shekel&FORMAT([__sales],"#,##0")&"</b></div>","")
				VAR SegRows = CONCATENATEX(TOPN(5, Seg, [__sales], DESC), VAR N=COALESCE(DimCustomer[CustomerSegment],"לא ידוע") VAR W=FORMAT(DIVIDE([__sales],MaxSeg,0)*100,"0")&"%" RETURN "<details class='mini'><summary><span>"&N&"</span><b>"&Shekel&FORMAT([__sales],"#,##0")&"</b></summary><div class='bar purple'><i style='width:"&W&"'></i></div><p>לקוחות בפלח: <b>"&FORMAT([__cust],"#,##0")&"</b></p></details>","")
				VAR Points = CONCATENATEX(YearT, VAR R=RANKX(YearT,DimDate[YearNumber],,ASC,Dense) VAR X=IF(YearCount<=1,330,62+DIVIDE(R-1,YearCount-1)*516) VAR Y=216-DIVIDE([__sales],MaxYear,0)*150 RETURN FORMAT(X,"0")&","&FORMAT(Y,"0")," ",DimDate[YearNumber],ASC)
				VAR Dots = CONCATENATEX(YearT, VAR R=RANKX(YearT,DimDate[YearNumber],,ASC,Dense) VAR X=IF(YearCount<=1,330,62+DIVIDE(R-1,YearCount-1)*516) VAR Y=216-DIVIDE([__sales],MaxYear,0)*150 RETURN "<g class='dot' style='animation-delay:"&FORMAT(R*.10,"0.00")&"s'><circle cx='"&FORMAT(X,"0")&"' cy='"&FORMAT(Y,"0")&"' r='6'></circle><text x='"&FORMAT(X,"0")&"' y='250'>"&FORMAT(DimDate[YearNumber],"0")&"</text><text class='val' x='"&FORMAT(X,"0")&"' y='"&FORMAT(Y-13,"0")&"'>"&FORMAT([__sales]/1000,"#,##0")&"K</text></g>","",DimDate[YearNumber],ASC)
				VAR Css = "*{box-sizing:border-box}body{margin:0;direction:rtl;font-family:Segoe UI,Arial,sans-serif;background:#eef3f8;color:#0b1f36}.wrap{min-height:100vh;padding:22px;background:linear-gradient(135deg,#f9fbfd 0%,#edf3f8 100%)}.hero{background:#fff;border:1px solid #e5ebf2;border-radius:28px;padding:22px 28px;box-shadow:0 20px 45px rgba(15,35,60,.08);display:flex;justify-content:space-between;gap:18px;align-items:center;animation:drop .5s ease both}.hero h1{margin:0;font-size:28px;line-height:1.1;color:#0b1f36}.hero p{margin:8px 0 0;color:#667085;font-size:12px}.pill{background:#0b3158;color:#fff;border-radius:999px;padding:10px 16px;font-size:12px;font-weight:800;white-space:nowrap}.pager{margin-top:18px;display:grid;gap:14px}.pageBlock{background:#fff;border:1px solid #e1e8f0;border-radius:22px;overflow:hidden;box-shadow:0 14px 32px rgba(15,35,60,.06);animation:rise .42s ease both}.pageBlock>summary{list-style:none;cursor:pointer;padding:18px 24px;display:flex;justify-content:space-between;align-items:center;gap:18px;font-weight:850;font-size:17px;color:#0b1f36;background:#fff}.pageBlock>summary::-webkit-details-marker{display:none}.pageBlock>summary:after{content:'+';width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#edf4fb;color:#0b3158;font-size:18px;flex:0 0 auto}.pageBlock[open]>summary{background:#0b3158;color:#fff}.pageBlock[open]>summary:after{content:'−';background:#fff;color:#0b3158}.sub{font-size:11px;font-weight:500;color:#7b8797;margin-top:4px}.pageBlock[open] .sub{color:#dbeafe}.body{padding:22px;animation:fade .35s ease both}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.kpi{border:1px solid #e6edf4;border-radius:16px;padding:18px;background:linear-gradient(180deg,#fff,#fbfdff)}.kpi strong{display:block;direction:ltr;text-align:right;font-size:26px;color:#0b1f36}.kpi span{display:block;margin-top:6px;font-weight:800}.kpi small{display:block;margin-top:12px;color:#667085;font-size:11px}.grid{display:grid;grid-template-columns:1fr 1.18fr;gap:16px;margin-top:16px}.panel{border:1px solid #e6edf4;border-radius:18px;background:#fff;padding:18px}.panel h3{font-size:17px;margin:0 0 14px}.r{display:grid;grid-template-columns:130px 1fr 95px;gap:12px;align-items:center;margin:12px 0;font-size:12px}.r span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r b,.mini b{direction:ltr;text-align:left}.bar{height:10px;background:#edf2f7;border-radius:999px;overflow:hidden}.bar i{display:block;height:100%;border-radius:999px;background:#1a78d2;animation:grow .9s ease both}.orange i{background:#f59e0b}.teal i{background:#16a34a}.purple i{background:#7c3aed}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.mini{border:1px solid #e8eef5;border-radius:14px;background:#fff;padding:13px;transition:.2s}.mini[open],.mini:hover{border-color:#b8d8ff;box-shadow:0 10px 22px rgba(26,120,210,.09)}.mini summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:10px;font-size:12px;font-weight:800}.mini summary::-webkit-details-marker{display:none}.mini p{margin:9px 0 0;color:#667085;font-size:11px}.chart{width:100%;height:286px;overflow:visible}.axis{stroke:#e5eaf0;stroke-width:1}.bench{fill:none;stroke:#bdcad8;stroke-width:3;stroke-dasharray:7 9}.line{fill:none;stroke:#1a78d2;stroke-width:4;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1000;stroke-dashoffset:1000;animation:draw 1.35s ease forwards}.dot circle{fill:#1a78d2;stroke:#fff;stroke-width:3;opacity:0;animation:pop .35s ease forwards}.dot text{text-anchor:middle;font-size:11px;fill:#667085}.dot .val{font-weight:900;fill:#344054}.note{margin-top:14px;color:#667085;font-size:12px}.wide{grid-template-columns:1fr}.productsGrid{display:grid;grid-template-columns:.95fr 1.05fr;gap:16px}@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@keyframes drop{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:none}}@keyframes fade{from{opacity:0}to{opacity:1}}@keyframes grow{from{width:0}}@keyframes draw{to{stroke-dashoffset:0}}@keyframes pop{to{opacity:1}}@media(max-width:900px){.hero{align-items:flex-start;flex-direction:column}.kpis,.grid,.productsGrid,.cards{grid-template-columns:1fr}.r{grid-template-columns:100px 1fr 82px}.wrap{padding:12px}.body{padding:14px}}"
				RETURN "<!DOCTYPE html><html dir='rtl' lang='he'><head><meta charset='UTF-8'><style>"&Css&"</style></head><body><main class='wrap'><section class='hero'><div><h1>דשבורד מכירות</h1><p>סקירה פתוחה כברירת מחדל. לחיצה על כל אזור למטה פותחת עמוד ניתוח נוסף בתוך אותו HTML.</p></div><div class='pill'>"&Shekel&FORMAT(TotalSales,"#,##0")&" מכירות</div></section><section class='pager'><details class='pageBlock' name='dashPage' open><summary><div>סקירה ניהולית<div class='sub'>תמונת מצב מיידית: מכירות, הזמנות, לקוחות ומובילים</div></div></summary><div class='body'><div class='kpis'><div class='kpi'><strong>"&Shekel&FORMAT(TotalSales,"#,##0")&"</strong><span>סהכ מכירות</span><small>ממוצע להזמנה "&Shekel&FORMAT(AvgOrder,"#,##0")&"</small></div><div class='kpi'><strong>"&FORMAT(Orders,"#,##0")&"</strong><span>הזמנות</span><small>כמות פריטים "&FORMAT(TotalQty,"#,##0")&"</small></div><div class='kpi'><strong>"&FORMAT(Customers,"#,##0")&"</strong><span>לקוחות</span><small>פלח מוביל: "&COALESCE(TopSeg,"אין נתונים")&"</small></div><div class='kpi'><strong>"&COALESCE(TopCity,"אין נתונים")&"</strong><span>עיר מובילה</span><small>מוצר מוביל: "&COALESCE(TopProd,"אין נתונים")&"</small></div></div><div class='grid'><div class='panel'><h3>קטגוריות מובילות</h3>"&CatRows&"</div><div class='panel'><h3>מגמת מכירות לאורך זמן</h3><svg class='chart' viewBox='0 0 640 286'><line class='axis' x1='58' y1='228' x2='590' y2='228'></line><line class='axis' x1='58' y1='52' x2='58' y2='228'></line><line class='bench' x1='62' y1='92' x2='578' y2='198'></line><polyline class='line' points='"&Points&"'></polyline>"&Dots&"</svg></div></div></div></details><details class='pageBlock' name='dashPage'><summary><div>מוצרים וקטגוריות<div class='sub'>מה נמכר הכי הרבה ואילו פריטים כדאי לקדם</div></div></summary><div class='body productsGrid'><div class='panel'><h3>מכירות לפי קטגוריה</h3>"&CatRows&"</div><div class='panel'><h3>מוצרים מובילים - לחיצה מרחיבה פרטים</h3><div class='cards'>"&ProdRows&"</div></div></div></details><details class='pageBlock' name='dashPage'><summary><div>לקוחות ומיקום<div class='sub'>איפה נמצאת ההכנסה ומי הפלחים המרכזיים</div></div></summary><div class='body productsGrid'><div class='panel'><h3>ערים מובילות</h3>"&CityRows&"</div><div class='panel'><h3>פלחי לקוחות - לחיצה מרחיבה פרטים</h3><div class='cards'>"&SegRows&"</div></div></div></details><details class='pageBlock' name='dashPage'><summary><div>זמן ומגמה<div class='sub'>האם המכירות עולות, יורדות או תנודתיות לאורך השנים</div></div></summary><div class='body'><div class='panel'><h3>קו מגמה שנתי</h3><svg class='chart' viewBox='0 0 640 286'><line class='axis' x1='58' y1='228' x2='590' y2='228'></line><line class='axis' x1='58' y1='52' x2='58' y2='228'></line><line class='bench' x1='62' y1='92' x2='578' y2='198'></line><polyline class='line' points='"&Points&"'></polyline>"&Dots&"</svg><div class='note'>המספרים מוצגים אופקית, והגרף נבנה מתוך שנת התאריך במודל.</div></div></div></details></section></main></body></html>"
			displayFolder: Dashboards
			lineageTag: 0cf7a403-439b-4921-bb1c-2d7c9c9557d4
			dataCategory: WebUrl

			annotation PBI_FormatHint = {"isText":true}

